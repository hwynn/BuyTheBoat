<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows, matching MyMoneyForecast.App itself — a plain net10.0
         test project can't reference a net10.0-windows one. No UseWPF: this
         project's own code never touches a WPF/XAML type directly, only
         plain classes (FinancePatternSaveConfirmation, FinancePatternRepositories)
         that happen to live in the App assembly. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyMoneyForecast.App\MyMoneyForecast.App.csproj" />
    <ProjectReference Include="..\..\src\MyMoneyForecast.Domain\MyMoneyForecast.Domain.csproj" />
    <ProjectReference Include="..\..\src\MyMoneyForecast.Persistence\MyMoneyForecast.Persistence.csproj" />
  </ItemGroup>

</Project>
