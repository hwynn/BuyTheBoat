<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows only because the tests still call EarmarkFormPanel's static text builders (AllocateTodayText, ConcurrentPlansSentence) in BuyTheBoat.App, and a plain net10.0 project can't reference a net10.0-windows one.
         Everything else tested here lives in BuyTheBoat.App.Core, which is plain net10.0.
         No UseWPF: no test creates a WPF control. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuyTheBoat.App\BuyTheBoat.App.csproj" />
    <ProjectReference Include="..\..\src\BuyTheBoat.App.Core\BuyTheBoat.App.Core.csproj" />
    <ProjectReference Include="..\..\src\BuyTheBoat.Domain\BuyTheBoat.Domain.csproj" />
    <ProjectReference Include="..\..\src\BuyTheBoat.Persistence\BuyTheBoat.Persistence.csproj" />
  </ItemGroup>

</Project>
