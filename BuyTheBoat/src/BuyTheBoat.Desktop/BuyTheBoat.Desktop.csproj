<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia version of the app, runs on Windows and Linux; being ported window by window from the WPF project BuyTheBoat.App, which it will replace.
       Its classes keep the BuyTheBoat.App namespace, so ported code and BuyTheBoat.App.Core's classes need no namespace changes. -->

  <ItemGroup>
    <ProjectReference Include="..\BuyTheBoat.Domain\BuyTheBoat.Domain.csproj" />
    <ProjectReference Include="..\BuyTheBoat.Persistence\BuyTheBoat.Persistence.csproj" />
    <ProjectReference Include="..\BuyTheBoat.App.Core\BuyTheBoat.App.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BuyTheBoat.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ported WPF XAML binds by name without declaring each view's data type, which compiled bindings require. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

</Project>
