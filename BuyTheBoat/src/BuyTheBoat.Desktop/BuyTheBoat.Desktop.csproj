<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app: Avalonia, runs on Windows and Linux.
       Its classes keep the BuyTheBoat.App namespace, the one BuyTheBoat.App.Core's classes use, so neither needs extra usings. -->

  <ItemGroup>
    <ProjectReference Include="..\BuyTheBoat.Domain\BuyTheBoat.Domain.csproj" />
    <ProjectReference Include="..\BuyTheBoat.Persistence\BuyTheBoat.Persistence.csproj" />
    <ProjectReference Include="..\BuyTheBoat.App.Core\BuyTheBoat.App.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The program file is BuyTheBoat (BuyTheBoat.exe on Windows), not the project's name. -->
    <AssemblyName>BuyTheBoat</AssemblyName>
    <!-- The app's version. The build scripts (build/make-portable.*) read it to name their output, like dist/BuyTheBoat-0.9-win-x64. -->
    <Version>0.9</Version>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BuyTheBoat.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The XAML binds by name without declaring each view's data type, which compiled bindings require. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

</Project>
