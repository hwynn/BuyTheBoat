<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BuyTheBoat.App.FinancialPatternPickerWindow"
        Title="Pick a Bill, Paycheck, or Goal" Height="480" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button x:Name="SelectButton" Content="Select" Width="90" Padding="0,5" HorizontalContentAlignment="Center"
                    Click="OnSelectClick" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
        <!-- One row per break-off chain; the date range spans the whole chain, and the form that opens it asks which segment when there's a choice. -->
        <DataGrid x:Name="PatternsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="All"
                  SelectionChanged="OnSelectionChanged" DoubleTapped="OnGridDoubleTapped"
                  AutomationProperties.AutomationId="FinancialPatternPickerGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/>
                <DataGridTextColumn Header="Date range" Binding="{Binding DateRangeText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
