<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BuyTheBoat.App.AccountFormPanel">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" MaxWidth="450"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Clear form" Width="90" Margin="0,0,8,0" Padding="0,5" HorizontalContentAlignment="Center" Click="OnClearClick"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Padding="0,5" HorizontalContentAlignment="Center" Click="OnSaveClick"
                    AutomationProperties.AutomationId="SaveAccountButton"/>
        </StackPanel>

        <!-- Characterization-field-block: holds the Advanced mode checkbox every form has.
             Account has nothing for Advanced mode to reveal yet. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox x:Name="AdvancedModeCheckBox" DockPanel.Dock="Right" Content="Advanced mode" VerticalAlignment="Center"/>
        </DockPanel>

        <HeaderedContentControl Theme="{StaticResource GroupBox}" Header="Account details" DockPanel.Dock="Top"
                                Width="420" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Account name"/>
                <TextBox x:Name="NameTextBox" Margin="0,2,0,0" AutomationProperties.AutomationId="AccountNameTextBox"/>
                <TextBlock FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Whatever you call it — Checking, Savings, Bills. Each account needs its own name."/>

                <TextBlock Text="Current balance" Margin="0,10,0,0"/>
                <TextBox x:Name="BalanceTextBox" Margin="0,2,0,0" AutomationProperties.AutomationId="AccountBalanceTextBox"/>
                <TextBlock FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="What this account holds right now. It can be negative if the account is overdrawn."/>

                <TextBlock Text="Safety cushion (optional)" Margin="0,10,0,0"/>
                <TextBox x:Name="CushionTextBox" Margin="0,2,0,0" AutomationProperties.AutomationId="AccountCushionTextBox"/>
                <TextBlock FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Money to hold back in this account so it isn't counted as free to spend. Leave blank for none."/>
            </StackPanel>
        </HeaderedContentControl>
    </DockPanel>
</UserControl>
