<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BuyTheBoat.App.SummaryRegion">
    <HeaderedContentControl Theme="{StaticResource GroupBox}" Header="Summary" Padding="6">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <!-- The informational column sits top-right beside the narrative, so "Fund jar, today" isn't pushed below a full-width band; the narrative and chart share the left. -->
                <StackPanel x:Name="AsideStack" DockPanel.Dock="Right" Width="190" Margin="14,0,0,0">
                    <TextBlock Text="Fund jar, today:" FontWeight="Bold"/>
                    <TextBlock x:Name="AsideText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <Border x:Name="TrajectorySeparator" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Margin="0,10,0,0" IsVisible="False"/>
                    <TextBlock x:Name="TrajectoryLabel" Text="Toward the goal:" FontWeight="Bold" Margin="0,10,0,0" IsVisible="False"/>
                    <TextBlock x:Name="TrajectoryText" TextWrapping="Wrap" Margin="0,2,0,0" IsVisible="False"/>
                    <TextBlock x:Name="FirstPaymentText" TextWrapping="Wrap" Margin="0,18,0,0" IsVisible="False"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="NarrativeText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Canvas x:Name="ChartCanvas" Height="150" ClipToBounds="True"/>
                </StackPanel>
            </DockPanel>
            <!-- Chart legend, filled in DrawChart with entries only for the lines actually drawn. -->
            <WrapPanel x:Name="LegendPanel" Margin="0,6,0,0"/>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
