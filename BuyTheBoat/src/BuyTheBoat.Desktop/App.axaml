<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BuyTheBoat.App.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Plain text inherits its size from the window, so the window carries the same 12-point default as the controls. -->
        <Style Selector="Window">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- The forms were laid out for WPF's 12-point default text; Fluent's 14 makes them wider than the window. -->
        <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

        <!-- Avalonia has no GroupBox; a HeaderedContentControl with this theme draws the same titled frame.
             Use as <HeaderedContentControl Theme="{StaticResource GroupBox}" Header="..."> -->
        <ControlTheme x:Key="GroupBox" TargetType="HeaderedContentControl">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <ContentPresenter x:Name="PART_HeaderPresenter" DockPanel.Dock="Top" Content="{TemplateBinding Header}"
                                              Margin="10,6,10,0" FontWeight="SemiBold"/>
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Application.Resources>
</Application>
