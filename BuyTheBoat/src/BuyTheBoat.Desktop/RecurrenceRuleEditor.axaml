<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BuyTheBoat.App.RecurrenceRuleEditor">
    <!-- The left column is 430 wide so the paired fields have room; the gutter column (*) takes the spare width, pushing the preview flush right.
         MinWidth keeps the two columns from touching. -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*" MinWidth="20"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: input form -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Repeat" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <!-- Frequency and Every, side by side. -->
            <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,10">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Frequency"/>
                    <ComboBox x:Name="FrequencyComboBox" Margin="0,2,0,0" HorizontalAlignment="Stretch" SelectedIndex="2"
                              SelectionChanged="OnSelectionChanged">
                        <ComboBoxItem Content="Daily" Tag="Daily"/>
                        <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                        <ComboBoxItem Content="Monthly" Tag="Monthly"/>
                        <ComboBoxItem Content="Yearly" Tag="Yearly"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Every"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBox x:Name="IntervalTextBox" Width="50" Margin="0,0,6,0" Text="1"/>
                        <TextBlock x:Name="IntervalUnitLabel" Text="week(s)" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- On these days (or days of month, depending on frequency) and Starts, side by side. -->
            <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,10">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="On these days" x:Name="ByDayLabel"/>
                    <WrapPanel x:Name="ByDayPanel" Margin="0,2,0,0">
                        <CheckBox Content="Mon" Tag="Monday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                        <CheckBox Content="Tue" Tag="Tuesday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                        <CheckBox Content="Wed" Tag="Wednesday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                        <CheckBox Content="Thu" Tag="Thursday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                        <CheckBox Content="Fri" Tag="Friday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                        <CheckBox Content="Sat" Tag="Saturday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                        <CheckBox Content="Sun" Tag="Sunday" Margin="0,0,10,4" IsCheckedChanged="OnCheckChanged"/>
                    </WrapPanel>
                    <TextBlock Text="(leave unchecked to repeat on the same weekday as the start date)"
                               x:Name="ByDayHint" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <TextBlock Text="On these day(s) of the month, e.g. 9, 25" x:Name="ByMonthDayLabel" TextWrapping="Wrap"/>
                    <TextBox x:Name="ByMonthDayTextBox" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Starts"/>
                    <CalendarDatePicker x:Name="StartDatePicker" Margin="0,2,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <!-- Ends shares its row with a slot for host content (SetLeadingContent), where Earmark's Amount sits; it's empty and hidden for Expense and Transfer.
                 EndsAfterCountRadio's label wraps to fit the half-width column. -->
            <Grid ColumnDefinitions="*,16,*" Margin="0,4,0,10">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="EndsHeader" Text="Ends" FontWeight="Bold"/>
                    <RadioButton x:Name="EndsOnDateRadio" Content="On date" GroupName="EndCondition" IsChecked="True"
                                 Margin="0,4,0,0" IsCheckedChanged="OnCheckChanged"/>
                    <CalendarDatePicker x:Name="UntilDatePicker" Margin="20,2,0,6" HorizontalAlignment="Stretch"/>
                    <RadioButton x:Name="EndsAfterCountRadio" GroupName="EndCondition" IsCheckedChanged="OnCheckChanged">
                        <TextBlock Text="After this many occurrences" TextWrapping="Wrap" MaxWidth="180"/>
                    </RadioButton>
                    <TextBox x:Name="CountTextBox" Width="60" HorizontalAlignment="Left" Margin="20,2,0,0"/>
                    <TextBlock x:Name="ResolvedUntilText" Margin="20,2,0,0" FontStyle="Italic" Foreground="DimGray"/>
                </StackPanel>
                <ContentControl x:Name="LeadingContentHost" Grid.Column="2" IsVisible="False"/>
            </Grid>

            <!-- Skip specific dates (RFC 5545 EXDATE), hidden unless a host calls ShowExcludedDatesEditor (only the Earmark savings-plan editor, "the glut case," mechanism C).
                 Picks from this schedule's real occurrences, so only a scheduled date can be skipped. -->
            <StackPanel x:Name="ExcludedDatesSection" Margin="0,0,0,10" IsVisible="False">
                <TextBlock Text="Skip specific dates" FontWeight="Bold"/>
                <TextBlock Text="Leave one of this schedule's own dates out — nothing gets generated for it, and whatever's already set aside stays right where it is."
                           FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                    <ComboBox x:Name="ExcludableOccurrenceComboBox" Width="170">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='{}{0:ddd, MMM d, yyyy}'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="SkipDateButton" Content="Skip" Margin="6,0,0,0" Padding="10,2" Click="OnSkipDateClick"/>
                </StackPanel>
                <ListBox x:Name="ExcludedDatesListBox" MaxHeight="90">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button Content="Restore" DockPanel.Dock="Right" Padding="6,0" Margin="6,0,0,0"
                                        Click="OnRestoreExcludedDateClick" Tag="{Binding}"/>
                                <TextBlock Text="{Binding StringFormat='{}{0:ddd, MMM d, yyyy}'}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Shown only in Advanced mode, since most editing never needs it. -->
            <TextBlock x:Name="RruleLabel" Text="RRULE" Margin="0,14,0,0" FontWeight="Bold" IsVisible="False"/>
            <TextBox x:Name="RruleStringTextBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,0"
                     Background="#FFF0F0F0" Padding="4" IsVisible="False"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Right: live calendar preview + textual occurrence list -->
        <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Preview" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <!-- MaxWidth stops this long caption from widening the Auto-sized column. -->
                <TextBlock Text="(highlighted dates are computed occurrences — clicking the calendar doesn't change anything)"
                           FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>

            <!-- The occurrence list is 180 wide to fit dates with their weekday ("Thu, Aug 6, 2026"). -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,16,180">
                <Calendar x:Name="PreviewCalendar" Grid.Column="0" VerticalAlignment="Top" SelectionMode="MultipleRange"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="All occurrences" FontWeight="Bold"/>
                    <!-- Always capped, so a long list scrolls inside itself instead of growing. -->
                    <ListBox x:Name="OccurrencesListBox" Margin="0,4,0,0" MaxHeight="220"/>
                    <!-- Shown when a valid rule lands on no dates, usually an end date on or before the start, which RecurrenceRule.Create accepts.
                         The date pickers block that; this catches what they can't, like a typed end date. -->
                    <TextBlock x:Name="EmptyScheduleNote" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="#FFB05A00" FontWeight="SemiBold" IsVisible="False"
                               AutomationProperties.AutomationId="EmptyScheduleNote"
                               Text="This schedule has no occurrences — check that the end date is after the start date."/>
                    <!-- Shows DefaultVisibleOccurrenceCount dates by default; the button's label always gives the total (see OnToggleOccurrencesClick). -->
                    <Button x:Name="ToggleOccurrencesButton" Content="Show all" HorizontalAlignment="Left"
                            Padding="6,2" Margin="0,4,0,0" Click="OnToggleOccurrencesClick" IsVisible="False"/>
                    <TextBlock x:Name="CaptionText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="#FFB05A00" IsVisible="False"/>
                    <!-- Legend for highlighted dates: the caller explains them through SetHighlight's legendText, since this control doesn't know why a date is highlighted.
                         The swatch color copies ShortDateHighlightBrush (code-behind). -->
                    <StackPanel x:Name="LegendPanel" Orientation="Horizontal" Margin="0,6,0,0" IsVisible="False">
                        <Border Width="10" Height="10" Background="#FFFFD9A0" BorderBrush="#FFB05A00" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LegendText" FontSize="10.5" Foreground="Gray" TextWrapping="Wrap" MaxWidth="160"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
