<Window x:Class="BuyTheBoat.App.ChainSegmentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Segment" Height="380" Width="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="This bill or paycheck has more than one segment in its history. Which one do you want to open? The current segment is shown in bold."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="SelectButton" Content="Select" Width="90" Padding="0,5" Click="OnSelectClick" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
        <DataGrid x:Name="SegmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick"
                  AutomationProperties.AutomationId="ChainSegmentPickerGrid">
            <!-- The current segment (the one editing would otherwise land on)
                 is set apart in bold, so it's obvious which one is live. -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding StatusText}" Width="Auto"/>
                <DataGridTextColumn Header="Date range" Binding="{Binding DateRangeText}" Width="2*"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
