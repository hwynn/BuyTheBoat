<Window x:Class="BuyTheBoat.App.EditingHistoryConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm This Change" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <!-- Shown only when a save's rows span more than one page, so the user knows "Continue…" leads to more questions. -->
        <TextBlock x:Name="PageIndicator" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,10" Visibility="Collapsed"/>
        <TextBlock x:Name="DescriptionText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <!-- Reads "Save" on the final page and "Continue…" before it (set in the constructor from request.IsFinalPage). -->
            <Button x:Name="CommitButton" Content="Save" Width="90" Padding="0,5" Click="OnSaveClick" IsDefault="True"/>
        </StackPanel>

        <!-- Filled in order from request.Rows; FinancePatternSaveConfirmation decides the rows, and this window only draws them and reads the choices back.
             The ScrollViewer and the window's MaxHeight (set in the constructor) make a page that still runs over scroll, instead of pushing the buttons off-screen. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
