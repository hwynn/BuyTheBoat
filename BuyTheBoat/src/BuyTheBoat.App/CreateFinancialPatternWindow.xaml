<Window x:Class="BuyTheBoat.App.CreateFinancialPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuyTheBoat.App"
        Title="Create Bill / Paycheck" Height="820" Width="1000"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" MaxWidth="550"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="CreateButton" Content="Create" Width="90" Padding="0,5" Click="OnCreateClick"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="Pattern details" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Source (matches bank/statement text)"/>
                        <TextBox x:Name="SourceTextBox" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Description (optional)"/>
                        <TextBox x:Name="DescriptionTextBox" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Account"/>
                        <ComboBox x:Name="AccountComboBox" Margin="0,2,0,0" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  AutomationProperties.AutomationId="AccountComboBox"/>
                        <TextBlock Text="Paid from / into this account." FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <StackPanel x:Name="DirectionPanel">
                            <TextBlock Text="Direction"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <RadioButton x:Name="ExpenseRadioButton" Content="Expense" GroupName="Direction" IsChecked="True" Checked="OnDirectionChanged" Margin="0,0,14,0"/>
                                <RadioButton x:Name="IncomeRadioButton" Content="Income" GroupName="Direction" Checked="OnDirectionChanged"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="AmountLabel" Text="Amount owed"/>
                        <TextBox x:Name="AmountTextBox" Margin="0,2,0,0" TextChanged="OnAmountChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Priority"/>
                        <TextBox x:Name="PriorityTextBox" Text="5" Margin="0,2,0,0"/>
                        <TextBlock Text="1 = lowest, higher = higher priority" FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel/>
                </UniformGrid>

                <!-- Two named options rather than a
                     checkbox, following the same reasoning that made
                     Expense/Income a radio pair — a checkbox's meaning depends
                     on reading its caption, two named options don't. Hidden for
                     income: money coming in is never something you skip
                     paying. -->
                <StackPanel x:Name="MandatoryPanel" Margin="0,10,0,0">
                    <TextBlock Text="If money got tight, could you skip this?"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="UnskippableRadioButton" Content="I have to pay this" GroupName="Skippable"
                                     IsChecked="True" Margin="0,0,18,0"/>
                        <RadioButton x:Name="SkippableRadioButton" Content="I could skip or delay it" GroupName="Skippable"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" FontSize="11" Margin="0,4,0,0"
                               Text="If your plan ever needs more money than you have, anything you could skip gives its money back first — what you have to pay is protected until everything skippable is empty. Both still get money set aside for them; this only decides what gives way when something has to."/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- The simple bill form asks "when does this stop?"
             and supplies the end date to the schedule editor itself, so the
             editor's own Ends controls step aside. Only two of the
             three answers are built here — the "it just keeps going" answer
             waits on the deferred indeterminate-length design. -->
        <GroupBox x:Name="StopQuestionBox" DockPanel.Dock="Top" Header="When does this stop?" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StopOnDateRadio" Content="On a date I know" GroupName="Stop" IsChecked="True" Checked="OnStopModeChanged" Margin="0,0,18,0"/>
                    <RadioButton x:Name="StopPaidOffRadio" Content="When I've paid it off (a loan)" GroupName="Stop" Checked="OnStopModeChanged"/>
                </StackPanel>
                <TextBlock Text="(“It just keeps going”, for bills that never end, is coming in a later update.)"
                           FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <StackPanel x:Name="StopOnDatePanel" Margin="0,8,0,0">
                    <TextBlock Text="End date"/>
                    <DatePicker x:Name="StopEndDatePicker" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0"
                                SelectedDateChanged="OnStopEndDatePicked"/>
                </StackPanel>

                <StackPanel x:Name="StopPaidOffPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="Total still owed"/>
                    <TextBox x:Name="TotalOwedTextBox" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0"
                             TextChanged="OnTotalOwedChanged"/>
                    <TextBlock x:Name="PayoffReadoutText" TextWrapping="Wrap" Foreground="DimGray" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Text="A rough floor — interest and fees will push the real payoff date later."
                               FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <local:RecurrenceRuleEditor x:Name="RuleEditor" DockPanel.Dock="Top"/>
    </DockPanel>
</Window>
