<Window x:Class="BuyTheBoat.App.EarmarkPatternPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Savings Plan Segment" Height="360" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="More than one savings plan segment exists for this goal. Which one do you want to open?"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="SelectButton" Content="Select" Width="90" Padding="0,5" Click="OnSelectClick" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
        <!-- Mirrors FinancialPatternPickerWindow's own shape (grid +
             Select/Cancel) — EarMarkPattern has no Source/Description of its
             own, so Amount/date range/starting allocation are what actually
             tells one segment apart from another here. -->
        <DataGrid x:Name="PlansGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick"
                  AutomationProperties.AutomationId="EarmarkPatternPickerGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="*"/>
                <DataGridTextColumn Header="Date range" Binding="{Binding DateRangeText}" Width="2*"/>
                <DataGridTextColumn Header="Already saved" Binding="{Binding StartingAllocationText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
