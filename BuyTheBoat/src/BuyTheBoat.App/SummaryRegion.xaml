<UserControl x:Class="BuyTheBoat.App.SummaryRegion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Summary">
        <StackPanel Margin="6">
            <DockPanel LastChildFill="True">
                <!-- The informational column sits at the TOP-RIGHT, aligned with the narrative,
                     so "Fund jar, today" isn't pushed down below a full-width summary band
                     (reclaims the white space above it). The narrative + chart share the left. -->
                <StackPanel x:Name="AsideStack" DockPanel.Dock="Right" Width="190" Margin="14,0,0,0">
                    <TextBlock Text="Fund jar, today:" FontWeight="Bold"/>
                    <TextBlock x:Name="AsideText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <Border x:Name="TrajectorySeparator" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TrajectoryLabel" Text="Toward the goal:" FontWeight="Bold" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TrajectoryText" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="FirstPaymentText" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="NarrativeText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Canvas x:Name="ChartCanvas" Height="150" ClipToBounds="True"/>
                </StackPanel>
            </DockPanel>
            <!-- Author, 2026-08-07: "I didn't even notice the legend in the
                 settled design. But yes, that would be helpful" — matches
                 the settled design's own chart legend. Populated in
                 code-behind (DrawChart), same as ChartCanvas's own children
                 — which entries appear depends on which lines actually got
                 drawn, not a fixed set. -->
            <WrapPanel x:Name="LegendPanel" Margin="0,6,0,0"/>
        </StackPanel>
    </GroupBox>
</UserControl>
