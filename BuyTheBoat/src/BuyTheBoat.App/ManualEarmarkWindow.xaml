<Window x:Class="BuyTheBoat.App.ManualEarmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Funds" Height="470" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" Margin="0,0,0,14"
                   Text="A one-off, manual adjustment on top of the automatic savings plan — add money to a fund on a day of your choosing, pull money back out to your free balance, or move money between funds. Only days within the fund's savings-plan timeline are valid: the plan is the fund's lifetime."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" MaxWidth="300"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Padding="0,5" Click="OnSaveClick"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="What do you want to do?"/>
            <ComboBox x:Name="ActionComboBox" Margin="0,2,0,10" SelectedIndex="0" SelectionChanged="OnInputsChanged">
                <ComboBoxItem Content="Add money to a fund"/>
                <ComboBoxItem Content="Withdraw back to free balance"/>
                <ComboBoxItem Content="Move between funds"/>
            </ComboBox>

            <TextBlock x:Name="JarLabelText" Text="Which fund?"/>
            <ComboBox x:Name="JarComboBox" Margin="0,2,0,10" SelectionChanged="OnInputsChanged"/>

            <StackPanel x:Name="TargetRow" Visibility="Collapsed">
                <TextBlock Text="Move to which fund?"/>
                <ComboBox x:Name="TargetComboBox" Margin="0,2,0,10" SelectionChanged="OnInputsChanged"/>
            </StackPanel>

            <TextBlock Text="On what day?"/>
            <DatePicker x:Name="EarmarkDatePicker" Margin="0,2,0,10" SelectedDateChanged="OnInputsChanged"/>

            <TextBlock Text="How much?"/>
            <TextBox x:Name="AmountTextBox" Margin="0,2,0,10"/>

            <!-- Live context from the currently-shown forecast, so the user can
                 see what the fund holds and what's free on the chosen day. -->
            <TextBlock x:Name="BalanceInfoText" TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
        </StackPanel>
    </DockPanel>
</Window>
