<UserControl x:Class="MyMoneyForecast.App.RecurrenceRuleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <!-- Left widened 330->390 and right changed *->Auto (2026-08-06,
                 first pass): Frequency/Every and On-these-days/Starts sit
                 side by side, and the right column sizes to its own content
                 instead of stretching to fill whatever's left.

                 That pass fixed the preview's own width, but not its
                 *position* — with this root Grid's own HorizontalAlignment
                 left at its default (Stretch), an Auto column doesn't reach
                 for the container's right edge; it sits directly after
                 Column 0+1, and any width the container has beyond
                 390+gutter+Auto's content is unclaimed space trailing after
                 the preview, not before it. That's what the author was still
                 seeing: pushed nowhere near the right edge.

                 2026-08-06, second pass: the gutter itself becomes the
                 flexible column (*) instead of a fixed 20 — it, not the
                 preview, absorbs whatever room the container has beyond what
                 the two content columns actually need, which is what
                 actually pushes the preview flush against the right edge.
                 MinWidth keeps a floor so the two columns never touch.

                 2026-08-06, third pass: removing Earmark's "Already saved"
                 field freed up room the author asked to spend here instead —
                 390->430 so Frequency/Every/On-these-days/Starts (currently
                 ~187px per side) have real breathing room, not just enough to
                 avoid overlapping. Deliberately not a bigger jump: "it
                 doesn't need to use all this extra space" (the author's own
                 words) — most of what's freed up still goes to the flexible
                 gutter, not either fixed column. -->
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*" MinWidth="20"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: input form -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Repeat" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <!-- Frequency + Every paired side by side (2026-08-06) — matches
                 settled-designs.html's own Earmark mockups, and is what
                 needed the extra left-column width above. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Frequency"/>
                    <ComboBox x:Name="FrequencyComboBox" Margin="0,2,0,0" SelectionChanged="OnSelectionChanged">
                        <ComboBoxItem Content="Daily" Tag="Daily"/>
                        <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                        <ComboBoxItem Content="Monthly" Tag="Monthly" IsSelected="True"/>
                        <ComboBoxItem Content="Yearly" Tag="Yearly"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Every"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBox x:Name="IntervalTextBox" Width="40" Margin="0,0,6,0" Text="1" TextChanged="OnTextChanged"/>
                        <TextBlock x:Name="IntervalUnitLabel" Text="week(s)" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- On-these-days (or On-these-day(s)-of-month, mutually
                 exclusive by frequency) + Starts, also paired (2026-08-06),
                 same mockup evidence as above. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="On these days" x:Name="ByDayLabel"/>
                    <WrapPanel x:Name="ByDayPanel" Margin="0,2,0,0">
                        <CheckBox Content="Mon" Tag="Monday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <CheckBox Content="Tue" Tag="Tuesday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <CheckBox Content="Wed" Tag="Wednesday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <CheckBox Content="Thu" Tag="Thursday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <CheckBox Content="Fri" Tag="Friday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <CheckBox Content="Sat" Tag="Saturday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <CheckBox Content="Sun" Tag="Sunday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    </WrapPanel>
                    <TextBlock Text="(leave unchecked to repeat on the same weekday as the start date)"
                               x:Name="ByDayHint" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <TextBlock Text="On these day(s) of the month, e.g. 9, 25" x:Name="ByMonthDayLabel"/>
                    <TextBox x:Name="ByMonthDayTextBox" Margin="0,2,0,0" TextChanged="OnTextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Starts"/>
                    <DatePicker x:Name="StartDatePicker" Margin="0,2,0,0" SelectedDateChanged="OnSelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Ends paired with a host-injection slot (2026-08-06) — this is
                 where Earmark's Amount field lives now (SetLeadingContent),
                 moved from its own dedicated band above "Repeat." Checked
                 planning/21 + planning/22 first: neither reserves anything
                 for the space beside Amount, so it was costing this column
                 height for nothing — sharing Ends' own already-existing row
                 instead means Amount adds essentially no extra height here,
                 since Ends' own content occupies that vertical span either
                 way. Empty/Collapsed by default for any caller that never
                 calls SetLeadingContent (Expense, Transfer) — same as
                 before the move, only the position within this column
                 changed. EndsAfterCountRadio's own label now wraps
                 explicitly (it didn't need to at the old full column width;
                 it does at half). -->
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="EndsHeader" Text="Ends" FontWeight="Bold"/>
                    <RadioButton x:Name="EndsOnDateRadio" Content="On date" GroupName="EndCondition" IsChecked="True"
                                 Margin="0,4,0,0" Checked="OnCheckChanged"/>
                    <DatePicker x:Name="UntilDatePicker" Margin="20,2,0,6" SelectedDateChanged="OnSelectionChanged"/>
                    <RadioButton x:Name="EndsAfterCountRadio" GroupName="EndCondition" Checked="OnCheckChanged">
                        <TextBlock Text="After this many occurrences" TextWrapping="Wrap" MaxWidth="180"/>
                    </RadioButton>
                    <TextBox x:Name="CountTextBox" Width="60" HorizontalAlignment="Left" Margin="20,2,0,0" TextChanged="OnTextChanged"/>
                    <TextBlock x:Name="ResolvedUntilText" Margin="20,2,0,0" FontStyle="Italic" Foreground="DimGray"/>
                </StackPanel>
                <ContentControl x:Name="LeadingContentHost" Grid.Column="2" Visibility="Collapsed"/>
            </Grid>

            <!-- Hidden unless a host turns on Advanced mode (the author's own
                 call, 2026-08-06 — planning/21's Advanced-mode section, which
                 only ever covered Expense, is now settled on location
                 [characterization-field-block, every form] but this is the
                 first concrete piece of *content* gated by it). Takes real
                 space for something most editing is never going to need. -->
            <TextBlock x:Name="RruleLabel" Text="RRULE" Margin="0,14,0,0" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBox x:Name="RruleStringTextBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,0"
                     Background="#FFF0F0F0" Padding="4" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Right: live calendar preview + textual occurrence list -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Preview" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <!-- MaxWidth capped (2026-08-06, tightened further in the
                     same-day follow-up pass below) — this column is
                     Auto-sized to its content, and an Auto measurement pass
                     gives its children effectively infinite available width,
                     so an unwrapped, uncapped caption this long would have
                     single-handedly dictated the whole column's width right
                     back up to "way too much horizontal space." -->
                <TextBlock Text="(highlighted dates are computed occurrences — clicking the calendar doesn't change anything)"
                           FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>

            <!-- Occurrence-list column: 220 -> 140 (first width pass,
                 2026-08-06) -> 180 (this pass, same day) — the author asked
                 to widen the preview "a little," and specifically asked the
                 occurrence dates to say what weekday they fall on again
                 (code-behind: "ddd, MMM d, yyyy", e.g. "Thu, Aug 6, 2026" —
                 up from the plain "MMM d, yyyy" the first pass shortened it
                 to). That's the actual reason this needs to be wider than
                 140 again: the weekday abbreviation is what no longer fits
                 there. Inner gutter 12->16 to match. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Calendar x:Name="PreviewCalendar" Grid.Column="0" VerticalAlignment="Top" SelectionMode="MultipleRange"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="All occurrences" FontWeight="Bold"/>
                    <!-- Capped unconditionally (was only capped when a host
                         caption was set) so expanding a long-running rule's
                         list can't reintroduce unbounded growth — the list
                         itself gets an internal scrollbar past this height. -->
                    <ListBox x:Name="OccurrencesListBox" Margin="0,4,0,0" MaxHeight="220"/>
                    <!-- Collapsed to DefaultVisibleOccurrenceCount dates by
                         default (the author's own call, 2026-08-06); this
                         button's own label carries the total count even
                         while collapsed. See OnToggleOccurrencesClick. -->
                    <Button x:Name="ToggleOccurrencesButton" Content="Show all" HorizontalAlignment="Left"
                            Padding="6,2" Margin="0,4,0,0" Click="OnToggleOccurrencesClick" Visibility="Collapsed"/>
                    <TextBlock x:Name="CaptionText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="#FFB05A00" Visibility="Collapsed"/>
                    <!-- Author, 2026-08-08: "a legend explaining the color
                         should appear... The function running the rrule
                         preview is ignorant of that, so the caller will
                         have to include that in the optional message
                         whenever it sends dates to be highlighted." This
                         control still doesn't know WHY a date is
                         highlighted or what it means — SetHighlight's own
                         new legendText parameter is the caller's answer to
                         that, shown here rather than assumed. Swatch color
                         is a literal copy of ShortDateHighlightBrush
                         (code-behind), not a separate constant to drift
                         from it. -->
                    <StackPanel x:Name="LegendPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <Border Width="10" Height="10" Background="#FFFFD9A0" BorderBrush="#FFB05A00" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LegendText" FontSize="10.5" Foreground="Gray" TextWrapping="Wrap" MaxWidth="160"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
