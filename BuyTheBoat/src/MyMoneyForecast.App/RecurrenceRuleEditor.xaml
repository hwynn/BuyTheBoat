<UserControl x:Class="MyMoneyForecast.App.RecurrenceRuleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: input form -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Repeat" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="Frequency"/>
            <ComboBox x:Name="FrequencyComboBox" Margin="0,2,0,0" SelectionChanged="OnSelectionChanged">
                <ComboBoxItem Content="Daily" Tag="Daily"/>
                <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                <ComboBoxItem Content="Monthly" Tag="Monthly" IsSelected="True"/>
                <ComboBoxItem Content="Yearly" Tag="Yearly"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Text="Every" VerticalAlignment="Center"/>
                <TextBox x:Name="IntervalTextBox" Width="40" Margin="6,0" Text="1" TextChanged="OnTextChanged"/>
                <TextBlock x:Name="IntervalUnitLabel" Text="week(s)" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="On these days" Margin="0,10,0,0" x:Name="ByDayLabel"/>
            <WrapPanel x:Name="ByDayPanel" Margin="0,2,0,0">
                <CheckBox Content="Mon" Tag="Monday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                <CheckBox Content="Tue" Tag="Tuesday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                <CheckBox Content="Wed" Tag="Wednesday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                <CheckBox Content="Thu" Tag="Thursday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                <CheckBox Content="Fri" Tag="Friday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                <CheckBox Content="Sat" Tag="Saturday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                <CheckBox Content="Sun" Tag="Sunday" Margin="0,0,10,4" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
            </WrapPanel>
            <TextBlock Text="(leave unchecked to repeat on the same weekday as the start date)"
                       x:Name="ByDayHint" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <TextBlock Text="On these day(s) of the month, e.g. 9, 25" Margin="0,10,0,0" x:Name="ByMonthDayLabel"/>
            <TextBox x:Name="ByMonthDayTextBox" Margin="0,2,0,0" TextChanged="OnTextChanged"/>

            <TextBlock Text="Starts" Margin="0,10,0,0"/>
            <DatePicker x:Name="StartDatePicker" Margin="0,2,0,0" SelectedDateChanged="OnSelectionChanged"/>

            <TextBlock x:Name="EndsHeader" Text="Ends" Margin="0,14,0,0" FontWeight="Bold"/>
            <RadioButton x:Name="EndsOnDateRadio" Content="On date" GroupName="EndCondition" IsChecked="True"
                         Margin="0,4,0,0" Checked="OnCheckChanged"/>
            <DatePicker x:Name="UntilDatePicker" Margin="20,2,0,6" SelectedDateChanged="OnSelectionChanged"/>
            <RadioButton x:Name="EndsAfterCountRadio" Content="After this many occurrences" GroupName="EndCondition"
                         Checked="OnCheckChanged"/>
            <TextBox x:Name="CountTextBox" Width="60" HorizontalAlignment="Left" Margin="20,2,0,0" TextChanged="OnTextChanged"/>
            <TextBlock x:Name="ResolvedUntilText" Margin="20,2,0,0" FontStyle="Italic" Foreground="DimGray"/>

            <TextBlock Text="RRULE" Margin="0,14,0,0" FontWeight="Bold"/>
            <TextBox x:Name="RruleStringTextBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,0"
                     Background="#FFF0F0F0" Padding="4"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Right: live calendar preview + textual occurrence list -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Preview" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="(highlighted dates are computed occurrences — clicking the calendar doesn't change anything)"
                           FontStyle="Italic" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Calendar x:Name="PreviewCalendar" Grid.Column="0" VerticalAlignment="Top" SelectionMode="MultipleRange"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="All occurrences" FontWeight="Bold"/>
                    <ListBox x:Name="OccurrencesListBox" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CaptionText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="#FFB05A00" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
