<Window x:Class="MyMoneyForecast.App.EditingHistoryConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm This Change" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock x:Name="DescriptionText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button Content="Save" Width="90" Padding="0,5" Click="OnSaveClick" IsDefault="True"/>
        </StackPanel>

        <!-- planning/28 Thread 2: every question/announcement is now a
             ConfirmationRow in request.Rows. The code-behind fills this panel
             from that list, in order — this window no longer knows which
             sections exist or what they mean. The wrapper
             (FinancePatternSaveConfirmation) decides the rows; this just draws
             them and reads the choices back. Deliberately still the minimal
             plain-WPF look, not the styled mockup. -->
        <StackPanel x:Name="RowsPanel"/>
    </DockPanel>
</Window>
