<Window x:Class="MyMoneyForecast.App.FinancialPatternPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Bill, Paycheck, or Goal" Height="480" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="SelectButton" Content="Select" Width="90" Padding="0,5" Click="OnSelectClick" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
        <!-- Description, Source, and the date range are deliberately the only
             three columns — the author's own call: that's what's needed to
             tell one FinancialPattern apart from another, including two
             segments of the same broken-up pattern (same Source, same-ish
             description, different date range). -->
        <DataGrid x:Name="PatternsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick"
                  AutomationProperties.AutomationId="FinancialPatternPickerGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/>
                <DataGridTextColumn Header="Date range" Binding="{Binding DateRangeText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
