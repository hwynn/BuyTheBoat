<Window x:Class="MyMoneyForecast.App.CreateEarMarkPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyMoneyForecast.App"
        Title="Create Savings Goal (Earmark Pattern)" Height="820" Width="1000"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" MaxWidth="550"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="CreateButton" Content="Create" Width="90" Padding="0,5" Click="OnCreateClick"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="Savings goal details" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Saving toward (an existing Bill/Paycheck/Goal entry)"/>
                <ComboBox x:Name="GoalComboBox" DisplayMemberPath="DisplayText" Margin="0,2,0,10"/>
                <TextBlock Text="Amount to set aside per occurrence. Its date range can't run past the goal's own due date."/>
                <TextBox x:Name="AmountTextBox" Margin="0,2,0,0"/>

                <TextBlock Text="Already saved toward this goal (optional)" Margin="0,10,0,0"/>
                <TextBox x:Name="StartingAllocationTextBox" Text="0" Margin="0,2,0,0"/>
                <TextBlock FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="If you already have money set aside for this — from before you started tracking it here — enter it so the forecast doesn't start this goal at $0."/>
            </StackPanel>
        </GroupBox>

        <local:SummaryRegion x:Name="Summary" DockPanel.Dock="Top" Margin="0,0,0,10"/>

        <local:RecurrenceRuleEditor x:Name="RuleEditor" DockPanel.Dock="Top"/>
    </DockPanel>
</Window>
