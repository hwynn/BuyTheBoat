<UserControl x:Class="MyMoneyForecast.App.ExpenseFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyMoneyForecast.App">
    <DockPanel Margin="8">
        <!-- Bottom bar: the two settled save buttons (planning/21 "The save
             controls"). Both persist identically; only where they navigate to
             afterward differs. StatusText added 2026-08-07 (author's own
             go-ahead) — planning/21's own "Four plan-health states, SETTLED
             2026-08-02" / "Labels, SETTLED 2026-08-05": the linked plan's
             own health, docked left per the mockup's own left-status /
             right-actions layout (settled-designs.html's "Expense · 1"). -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="#FF9A4F08" Background="#FFFBF0E2" Padding="6,4" Visibility="Collapsed"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" MaxWidth="450"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="SaveAndSkipPlanningButton" Content="Save and Skip planning" Padding="8,5" Margin="0,0,8,0" Click="OnSaveAndSkipPlanningClick"/>
                <Button x:Name="SaveAndPlanButton" Content="Save and Plan" Padding="8,5" Click="OnSaveAndPlanClick"/>
            </StackPanel>
        </DockPanel>

        <!-- Wrapped in a ScrollViewer, added 2026-08-06 — same fix, same
             reasoning as EarmarkFormPanel (see its own comment there): this
             form stacks strictly more regions (instance-info-block,
             characterization-block, Details, Due-date/Stop-question,
             RecurrenceRuleEditor, Summary) with nothing to scroll them, so
             the just-added Summary region below would be equally
             unreachable once the tab ran out of height. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- REGION 1 — the instance-information-block (planning/21 "Form
                     layout, top to bottom" #1). Topmost, always. Which instance is
                     loaded, whether it has unsaved edits, and the controls to
                     discard those edits or start a blank one. No delete button here
                     — deletion stays on the Expenses list tab, next to the row. -->
                <Border BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ModifiedIndicatorText" Text="● Unsaved changes" Foreground="DarkOrange"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                            <!-- "Discard changes" wording is explicitly OPEN in planning/21
                                 ("Exact wording: OPEN") — provisional, easy to retitle later. -->
                            <Button x:Name="DiscardChangesButton" Content="Discard changes" Padding="8,3" Margin="0,0,8,0" Click="OnDiscardChangesClick"/>
                            <Button Content="Clear form" Padding="8,3" Click="OnClearClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Editing" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- The button opens FinancialPatternPickerWindow (the
                                 author's own call, 2026-08-06) — not a ComboBox, and
                                 not the fancier searchable control planning/21 leaves
                                 undecided; this is the one settled shape, reused the
                                 same way in every form's instance-info-block except
                                 Account's. Setting SelectedInstanceText directly (not
                                 through this button) is also how a MainWindow
                                 shortcut ("Edit Selected...", "Create Bill...") lands
                                 on this form — programmatically, the popup never
                                 visibly opens on its own (Philosophy 6). -->
                            <TextBlock x:Name="SelectedInstanceText" Text="— New Expense —" VerticalAlignment="Center"
                                       Margin="0,0,8,0" FontWeight="SemiBold" AutomationProperties.AutomationId="SelectedInstanceText"/>
                            <Button Content="Change..." Padding="8,3" Click="OnChangeInstanceClick"
                                    AutomationProperties.AutomationId="ChangeInstanceButton"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- REGION 2 — the characterization-field-block (planning/21 "Form
                     layout, top to bottom" #2; Expense Step 1, SETTLED 2026-07-30).
                     What KIND of thing this is, plus a computed, always-present label. -->
                <GroupBox Header="What is this?" Padding="10" Margin="0,0,0,10">
                    <DockPanel>
                        <!-- Advanced mode (the author's own call, 2026-08-06;
                             planning/21's own Advanced-mode section only ever
                             covered Expense, with its content itself partly
                             still undecided — see this control's own doc
                             comment in code-behind for exactly what's wired
                             today vs. what still isn't). -->
                        <CheckBox x:Name="AdvancedModeCheckBox" DockPanel.Dock="Right" Content="Advanced mode" VerticalAlignment="Center"
                                  Checked="OnAdvancedModeChanged" Unchecked="OnAdvancedModeChanged"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel x:Name="DirectionPanel" Margin="0,0,30,0">
                                <TextBlock Text="Direction"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton x:Name="ExpenseRadioButton" Content="Expense" GroupName="Direction" IsChecked="True" Checked="OnDirectionChanged" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="IncomeRadioButton" Content="Income" GroupName="Direction" Checked="OnDirectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Repeats?"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton x:Name="OneTimeRadioButton" Content="One time" GroupName="Repeats" Checked="OnRepeatsChanged" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RepeatingRadioButton" Content="Repeating" GroupName="Repeats" IsChecked="True" Checked="OnRepeatsChanged"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="This looks like a:" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="CharacterizationText" Text="Custom" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </GroupBox>

                <!-- REGION 3 — everything else. Not yet organized into named
                     sub-blocks per planning/21 ("Everything else" is literally its
                     own heading with no further breakdown), so this stays one
                     GroupBox of the remaining consistent fields. -->
                <GroupBox Header="Details" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Source (matches bank/statement text)"/>
                                <TextBox x:Name="SourceTextBox" Margin="0,2,0,0" TextChanged="OnFieldChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Description (optional)"/>
                                <TextBox x:Name="DescriptionTextBox" Margin="0,2,0,0" TextChanged="OnFieldChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Account"/>
                                <ComboBox x:Name="AccountComboBox" Margin="0,2,0,0" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectionChanged="OnFieldChanged" AutomationProperties.AutomationId="AccountComboBox"/>
                                <TextBlock Text="Paid from / into this account." FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="AmountLabel" Text="Amount owed"/>
                                <TextBox x:Name="AmountTextBox" Margin="0,2,0,0" TextChanged="OnAmountChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Priority"/>
                                <TextBox x:Name="PriorityTextBox" Text="5" Margin="0,2,0,0" TextChanged="OnFieldChanged"/>
                                <TextBlock Text="1 = lowest, higher = higher priority" FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel/>
                        </UniformGrid>

                        <!-- planning/14 item B-3/B-4: hidden for income — money coming
                             in is never something you skip paying. -->
                        <StackPanel x:Name="MandatoryPanel" Margin="0,10,0,0">
                            <TextBlock Text="If money got tight, could you skip this?"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="UnskippableRadioButton" Content="I have to pay this" GroupName="Skippable"
                                             IsChecked="True" Checked="OnMandatoryChanged" Margin="0,0,18,0"/>
                                <RadioButton x:Name="SkippableRadioButton" Content="I could skip or delay it" GroupName="Skippable" Checked="OnMandatoryChanged"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" FontSize="11" Margin="0,4,0,0"
                                       Text="If your plan ever needs more money than you have, anything you could skip gives its money back first — what you have to pay is protected until everything skippable is empty. Both still get money set aside for them; this only decides what gives way when something has to."/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- One-time (planning/21 Expense Step 2, "RESOLVED 2026-08-02"): a
                     single plain date, not the full recurrence machinery. Internally
                     still becomes a real one-occurrence RecurrenceRule at save time. -->
                <StackPanel x:Name="DueDatePanel" Margin="0,0,0,10">
                    <TextBlock Text="Due date"/>
                    <DatePicker x:Name="DueDatePicker" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0" SelectedDateChanged="OnFieldChanged"/>
                </StackPanel>

                <!-- Repeating: "when does this stop?" now shows for every repeating
                     Expense (planning/21 Step 2's Stops… trigger table), not only the
                     old "Create Bill" shortcut — supplies the schedule editor's end
                     date itself, so its own raw Ends controls step aside (ruling D-1). -->
                <GroupBox x:Name="StopQuestionBox" Header="When does this stop?" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StopOnDateRadio" Content="On a date I know" GroupName="Stop" IsChecked="True" Checked="OnStopModeChanged" Margin="0,0,18,0"/>
                            <RadioButton x:Name="StopPaidOffRadio" Content="When I've paid it off (a loan)" GroupName="Stop" Checked="OnStopModeChanged" Margin="0,0,18,0"/>
                            <!-- TODO (2026-08-05): "Keeps going" stays disabled — per
                                 B12's ruling it should just set an invisible AutoRenew
                                 flag with nothing else to configure, but that flag's
                                 own domain-level support was, as of the popup this
                                 replaced, still waiting on the indeterminate-length
                                 design (planning/15) to finish landing. Not this
                                 panel's gap to close. -->
                            <RadioButton Content="It just keeps going" GroupName="Stop" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock Text="(“It just keeps going” isn't wired up yet — coming in a later update.)"
                                   FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <StackPanel x:Name="StopOnDatePanel" Margin="0,8,0,0">
                            <TextBlock Text="End date"/>
                            <DatePicker x:Name="StopEndDatePicker" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        SelectedDateChanged="OnStopEndDatePicked"/>
                        </StackPanel>

                        <StackPanel x:Name="StopPaidOffPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Total still owed"/>
                            <TextBox x:Name="TotalOwedTextBox" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0"
                                     TextChanged="OnTotalOwedChanged"/>
                            <TextBlock x:Name="PayoffReadoutText" TextWrapping="Wrap" Foreground="DimGray" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Text="A rough floor — interest and fees will push the real payoff date later."
                                       FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <local:RecurrenceRuleEditor x:Name="RuleEditor" Margin="0,0,0,10"/>

                <!-- The author's own call, 2026-08-06: this Expense's linked savings
                     plan, shown the same way Earmark shows its own — present even in
                     the plain healthy state, not only surfaced through a warning.
                     Read-only here; the plan itself is edited on the Earmark tab. -->
                <local:SummaryRegion x:Name="Summary"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
