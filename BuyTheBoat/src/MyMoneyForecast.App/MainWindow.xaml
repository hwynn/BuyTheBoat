<Window x:Class="MyMoneyForecast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyMoneyForecast" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="MyMoneyForecast" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export Data..." Padding="12,5" Click="OnExportClick"/>
                <Button Content="Import Data..." Padding="12,5" Margin="8,0,0,0" Click="OnImportClick"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Forecast">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="As of" FontSize="11" Foreground="Gray"/>
                            <DatePicker x:Name="AsOfDatePicker" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Current balance" FontSize="11" Foreground="Gray"/>
                            <TextBox x:Name="CurrentBalanceTextBox" Width="120" VerticalAlignment="Bottom" Height="23"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Show forecast through" FontSize="11" Foreground="Gray"/>
                            <DatePicker x:Name="HorizonEndDatePicker" Width="130"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Safety cushion" FontSize="11" Foreground="Gray"/>
                            <TextBox x:Name="SafetyCushionTextBox" Width="110" VerticalAlignment="Bottom" Height="23"/>
                        </StackPanel>
                        <Button Content="Forecast" Padding="16,5" VerticalAlignment="Bottom" Click="OnForecastClick"/>
                        <Button x:Name="ExportForecastSpreadsheetButton" Content="Export as Spreadsheet..." Padding="16,5" Margin="8,0,0,0"
                                VerticalAlignment="Bottom" IsEnabled="False" Click="OnExportForecastSpreadsheetClick"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               Text="Forecast only — assumes every bill and paycheck happens exactly as scheduled. No real transactions are tracked yet. Select a day in the timeline to see everything that day holds."/>

                    <Grid DockPanel.Dock="Bottom" Height="210" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DayDetailHeader" Text="Selected day" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="JarDetailGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.RowStyle>
                                    <!-- A jar raided to cover a shortfall on a deallocation day is shown in red. -->
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drained}" Value="True">
                                                <Setter Property="Background" Value="#FFF6E0E0"/>
                                                <Setter Property="Foreground" Value="#FFB00020"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Allocation" Binding="{Binding Jar}" Width="200"/>
                                    <DataGridTextColumn Header="Saved by this day" Binding="{Binding Saved, StringFormat={}{0:C}}" Width="120"/>
                                    <DataGridTextColumn Header="Should have saved" Binding="{Binding ShouldHaveSaved}" Width="125"/>
                                    <DataGridTextColumn Header="Due date" Binding="{Binding DueDate}" Width="90"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="DayEventsGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="160"/>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="140"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Timeline" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="TimelineGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionChanged="OnTimelineSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/>
                                <DataGridTextColumn Header="Expected Balance" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="130"/>
                                <DataGridTextColumn Header="Reserved" Binding="{Binding Reserved}" Width="260"/>
                                <DataGridTextColumn Header="Free Balance" Binding="{Binding FreeBalance, StringFormat={}{0:C}}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <!-- Free balance in the red on days it goes negative. -->
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FreeBalanceNegative}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB00020"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Events" Binding="{Binding Events}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Bills &amp; Paychecks">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Create Bill..." Padding="12,5" Click="OnCreateBillClick"/>
                        <Button Content="Add New (advanced)..." Padding="12,5" Margin="8,0,0,0" Click="OnAddFinancialPatternClick"/>
                        <Button Content="Edit Selected..." Padding="12,5" Margin="8,0,0,0" Click="OnEditFinancialPatternClick"/>
                        <Button Content="Delete Selected" Padding="12,5" Margin="8,0,0,0" Click="OnDeleteFinancialPatternClick"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               Text="A bill and a paycheck are the same kind of thing here — just a negative vs. positive amount. &quot;Create Bill&quot; is the simple path for a recurring expense you're obligated to pay; &quot;Add New (advanced)&quot; also covers paychecks, one-time goals, and anything discretionary."/>
                    <DataGrid x:Name="FinancialPatternsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Finance ID" Binding="{Binding FinanceId}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="110"/>
                            <DataGridTextColumn Header="Mandatory" Binding="{Binding Mandatory}" Width="80"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>
                            <DataGridTextColumn Header="Repeats" Binding="{Binding Repeats}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Allocations (Earmark Patterns)">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Create One-Time Goal..." Padding="12,5" Click="OnCreateOneTimeGoalClick"/>
                        <Button Content="Add New (advanced)..." Padding="12,5" Margin="8,0,0,0" Click="OnAddEarMarkPatternClick"/>
                        <Button Content="Edit Selected..." Padding="12,5" Margin="8,0,0,0" Click="OnEditEarMarkPatternClick"/>
                        <Button Content="Delete Selected" Padding="12,5" Margin="8,0,0,0" Click="OnDeleteEarMarkPatternClick"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               Text="Setting money aside ahead of an expense — the same mechanism (a fund jar fed by an earmark pattern) covers bills, one-time goals, and eventually the safety cushion. &quot;Create One-Time Goal&quot; is the simple path for a single future expense; &quot;Add New (advanced)&quot; links a custom allocation schedule to any existing Bill/Paycheck/Goal entry. Rows marked &quot;(Automatic)&quot; aren't something you created — every mandatory bill without its own earmark reserves money toward itself automatically; there's nothing to edit or delete there."/>
                    <DataGrid x:Name="EarMarkPatternsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Allocation target" Binding="{Binding Goal}" Width="280"/>
                            <DataGridTextColumn Header="Amount per occurrence" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="160"/>
                            <DataGridTextColumn Header="Already Saved" Binding="{Binding StartingAllocation, StringFormat={}{0:C}}" Width="120"/>
                            <DataGridTextColumn Header="Repeats" Binding="{Binding Repeats}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
