<Window x:Class="MyMoneyForecast.App.CreateFinancialPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyMoneyForecast.App"
        Title="Create Bill / Paycheck" Height="820" Width="1000"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" MaxWidth="550"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="0,5" Click="OnCancelClick"/>
            <Button x:Name="CreateButton" Content="Create" Width="90" Padding="0,5" Click="OnCreateClick"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="Pattern details" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Source (matches bank/statement text)"/>
                        <TextBox x:Name="SourceTextBox" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Description (optional)"/>
                        <TextBox x:Name="DescriptionTextBox" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel/>
                    <StackPanel Margin="0,0,10,0">
                        <StackPanel x:Name="DirectionPanel">
                            <TextBlock Text="Direction"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <RadioButton x:Name="ExpenseRadioButton" Content="Expense" GroupName="Direction" IsChecked="True" Checked="OnDirectionChanged" Margin="0,0,14,0"/>
                                <RadioButton x:Name="IncomeRadioButton" Content="Income" GroupName="Direction" Checked="OnDirectionChanged"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="AmountLabel" Text="Amount owed"/>
                        <TextBox x:Name="AmountTextBox" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Priority"/>
                        <TextBox x:Name="PriorityTextBox" Text="5" Margin="0,2,0,0"/>
                        <TextBlock Text="1 = lowest, higher = higher priority" FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel/>
                </UniformGrid>

                <StackPanel x:Name="MandatoryPanel" Margin="0,10,0,0">
                    <CheckBox x:Name="MandatoryCheckBox" Content="Mandatory" Checked="OnMandatoryToggledByUser" Unchecked="OnMandatoryToggledByUser"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" FontSize="11" Margin="20,4,0,0"
                               Text="Checked: a bill you're obligated to pay (rent, utilities, debt) — outranks non-mandatory patterns when money is short. Unchecked: discretionary — a paycheck, or an expense that's nice to have but skippable if needed (a subscription, a planned purchase, a savings goal). Suggested automatically from Expense/Income above (Expense → checked) until you set it yourself."/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <local:RecurrenceRuleEditor x:Name="RuleEditor" DockPanel.Dock="Top"/>
    </DockPanel>
</Window>
