<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only data seeder — populates the app's real local database (the same file the app reads/writes) with a realistic household worth of data, through the actual domain + persistence layers so everything it creates is valid by construction.
       It's part of BuyTheBoat.slnx, so building the solution compiles it, but nothing runs it; run it explicitly with dotnet run, pointing at this project's path.
       Kept (not deleted after one run) since it's cheap to re-run whenever the dev database needs resetting to a known, inspectable state. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuyTheBoat.Domain\BuyTheBoat.Domain.csproj" />
    <ProjectReference Include="..\..\src\BuyTheBoat.Persistence\BuyTheBoat.Persistence.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
